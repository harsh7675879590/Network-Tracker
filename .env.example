# ============================================================================
# NetworkTracker — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it may contain secrets.
# ============================================================================

# ── PostgreSQL ──
POSTGRES_DB=networktracker
POSTGRES_USER=networktracker
POSTGRES_PASSWORD=networktracker

# ── TimescaleDB ──
TIMESCALEDB_DB=networktracker_ts
TIMESCALEDB_USER=networktracker
TIMESCALEDB_PASSWORD=networktracker

# ── Keycloak ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=networktracker
KEYCLOAK_FRONTEND_CLIENT_ID=networktracker-frontend
KEYCLOAK_BACKEND_CLIENT_ID=networktracker-backend
KEYCLOAK_INTERNAL_CLIENT_ID=internal-service
KEYCLOAK_INTERNAL_CLIENT_SECRET=internal-service-secret

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TRAFFIC_TOPIC=network.traffic.raw
KAFKA_ALERTS_TOPIC=network.congestion.alerts

# ── ChromaDB ──
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── OpenTelemetry ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=networktracker

# ── Spring Boot Backend ──
SPRING_BOOT_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/networktracker
SPRING_DATASOURCE_USERNAME=networktracker
SPRING_DATASOURCE_PASSWORD=networktracker
TIMESCALEDB_URL=jdbc:postgresql://timescaledb:5432/networktracker_ts
TIMESCALEDB_USERNAME=networktracker
TIMESCALEDB_PASSWORD=networktracker
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/networktracker

# ── FastAPI Services ──
RAG_SERVICE_URL=http://rag-service:8100
FORECAST_SERVICE_URL=http://forecast-service:8101
CONGESTION_SERVICE_URL=http://congestion-service:8102

# ── Network Data Simulator ──
SIMULATOR_RATE_PER_SECOND=10
SIMULATOR_ANOMALY_PROBABILITY=0.05

# ── Frontend ──
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=networktracker
VITE_KEYCLOAK_CLIENT_ID=networktracker-frontend
VITE_API_BASE_URL=http://localhost:8081
VITE_WS_URL=ws://localhost:8081/ws/alerts
